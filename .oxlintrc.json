{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "categories": {
        "correctness": "error",
        "suspicious": "warn"
    },
    "plugins": ["typescript", "import", "unicorn", "oxc", "vitest"],
    "ignorePatterns": [
        "**/dist/**",
        "**/node_modules/**",
        "**/coverage/**",
        "**/.trace/**",
        "**/*.d.ts"
    ],
    "rules": {
        "no-console": "warn",
        "no-debugger": "error",
        "no-var": "error",
        "prefer-const": "error",
        "eqeqeq": "error"
    },
    "overrides": [
        {
            "files": ["packages/migrate/src/**/*.ts"],
            "rules": {
                "no-console": "off"
            }
        }
    ]
}
