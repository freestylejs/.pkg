{
    "name": "@freestylejs/migrate",
    "version": "0.0.0",
    "description": "Policy-driven migration CLI for freestylejs repositories.",
    "license": "MIT",
    "type": "module",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/freestylejs/.pkg.git",
        "directory": "packages/migrate"
    },
    "bugs": {
        "url": "https://github.com/freestylejs/.pkg/issues"
    },
    "homepage": "https://github.com/freestylejs/.pkg/tree/main/packages/migrate#readme",
    "engines": {
        "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
    },
    "bin": {
        "freestyle-migrate": "./dist/cli.js"
    },
    "files": [
        "dist"
    ],
    "exports": {
        ".": "./dist/cli.js"
    },
    "scripts": {
        "build": "tsdown",
        "build:fast": "tsdown --no-dts",
        "dev": "node --watch src/cli.ts",
        "migrate": "node src/cli.ts",
        "ts:typecheck": "tsc --noEmit --skipLibCheck"
    },
    "dependencies": {
        "@babel/parser": "7.28.5",
        "jsonc-parser": "3.3.1"
    }
}
