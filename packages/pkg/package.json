{
    "name": "@freestylejs/pkg",
    "author": "freestyle",
    "version": "0.0.1",
    "description": "DESCRIPTION",
    "license": "UNLICENSED",
    "type": "module",
    "keywords": [],
    "sideEffects": false,
    "private": true,
    "publishConfig": {
        "access": "restricted"
    },
    "files": ["dist"],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
