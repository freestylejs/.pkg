            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "scripts": {
        "build": "vp pack",
        "build:fast": "vp pack --no-dts",
        "dev": "vp pack --watch --sourcemap",
        "ts:typecheck": "tsc --noEmit --skipLibCheck"
    }
