{
    "name": "@freestylejs/monorepo-template",
    "version": "1.0.0",
    "type": "module",
    "private": true,
    "description": "Monorepo template for freestyle codebase.",
    "keywords": [
        "freestyle",
        "monorepo",
        "template"
    ],
    "author": "freestyle",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/freestylejs/.pkg.git"
    },
    "bugs": {
        "url": "https://github.com/freestylejs/.pkg/issues"
    },
    "homepage": "https://github.com/freestylejs/.pkg#readme",
    "engines": {
        "node": "^22.18.0 || ^24.11.0 || >=26.0.0",
        "pnpm": ">=10.20.0"
    },
    "scripts": {
        "dev": "turbo run build && turbo run dev",
        "build": "turbo run build",
        "build:clean": "pnpm reset:dist && turbo run build --force",
        "build:fast": "turbo run build:fast",
        "start": "turbo run start",
        "test": "vitest",
        "test:watch": "vitest --watch -u",
        "test:coverage": "vitest run --coverage",
        "test:ci": "pnpm sync:check && pnpm build && pnpm check && pnpm test:coverage",
        "sync:toolchain": "freestyle-sync-toolchain --write",
        "sync:check": "freestyle-sync-toolchain --check",
        "verify:package": "publint packages/pkg && publint packages/migrate && attw --pack packages/pkg && node scripts/verify-package.mjs",
        "ts:typecheck": "turbo run ts:typecheck",
        "ts:perf": "rimraf ts-perf && tsc --noEmit --generateTrace ts-perf",
        "lint": "oxlint --fix --deny-warnings",
        "format": "oxfmt .",
        "check": "oxlint --deny-warnings && oxfmt --check .",
        "report": "oxlint --deny-warnings",
        "reset:turbo": "turbo run clean",
        "reset:dist": "pnpm -r --parallel exec rimraf dist .turbo",
        "reset:modules": "pnpm -r --parallel exec rimraf node_modules && rimraf node_modules .turbo",
        "reset": "pnpm reset:dist && pnpm reset:modules",
        "pkg:init": "pnpm test:ci && changeset",
        "pkg:version": "changeset version",
        "pkg:publish": "changeset publish",
        "pre-commit": "lint-staged"
    },
    "packageManager": "pnpm@10.20.0",
    "devDependencies": {
        "@arethetypeswrong/cli": "0.18.5",
        "@changesets/cli": "2.29.7",
        "@freestylejs/config": "1.5.0",
        "@types/node": "24.10.0",
        "@vitest/coverage-v8": "5.0.5",
        "husky": "9.1.7",
        "lint-staged": "16.2.6",
        "oxfmt": "0.74.0",
        "oxlint": "1.89.0",
        "publint": "0.3.25",
        "rimraf": "6.1.3",
        "tsdown": "0.23.2",
        "turbo": "2.11.10",
        "typescript": "7.0.2",
        "vite": "8.3.5",
        "vitest": "5.0.5"
    }
}
